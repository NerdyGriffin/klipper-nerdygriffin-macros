# Host-local settings for the dev/ scripts. Copy to dev/.env (git-ignored)
# and edit on each host. Every value except PEER_HOST and PEER_CONFIG_REPO
# has a default.

# Hostname of the other printer. Used for SSH and for its Moonraker API.
PEER_HOST=other-printer

# Git URL of the other printer's config repo. sync_peer_config.sh keeps a
# read-only clone of it at PEER_CONFIG_CLONE for cross-referencing.
PEER_CONFIG_REPO=git@github.com:example/Klipper-Config-other.git

# SSH target for the peer when it differs from PEER_HOST (IP or ssh_config alias).
#PEER_SSH=192.0.2.10

# Local paths.
#CONFIG_DIR=$HOME/printer_data/config
#MACROS_DIR=$HOME/klipper-nerdygriffin-macros

# Same paths on the peer (default: identical to the local paths).
#PEER_CONFIG_DIR=/home/pi/printer_data/config
#PEER_MACROS_DIR=/home/pi/klipper-nerdygriffin-macros

# Where the peer config clone lives (default: $HOME/<repo name>).
#PEER_CONFIG_CLONE=$HOME/Klipper-Config-other

# Log and lock dir for sync_local_repos.sh (daily cron).
#SYNC_LOCAL_REPOS_DIR=$HOME/.local/state/nerdygriffin-macros
