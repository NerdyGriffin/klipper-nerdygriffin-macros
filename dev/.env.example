# Host-local settings for the dev/ scripts. Copy to dev/.env (git-ignored)
# and edit on each host. Every value except PEER_HOST has a default.

# Hostname of the other printer. Used for the mount point
# (/mnt/<PEER_HOST>/printer_data/config), the fstab source, and SSH.
PEER_HOST=other-printer

# SSH target for the peer when it differs from PEER_HOST (IP or ssh_config alias).
#PEER_SSH=192.0.2.10

# Client name or address the peer must allow in /etc/exports.
#PEER_EXPORT_CLIENT=192.0.2.10

# Local paths.
#CONFIG_DIR=$HOME/printer_data/config
#MACROS_DIR=$HOME/klipper-nerdygriffin-macros

# Same paths on the peer (default: identical to the local paths).
#PEER_CONFIG_DIR=/home/pi/printer_data/config
#PEER_MACROS_DIR=/home/pi/klipper-nerdygriffin-macros

# Where the peer config is mounted.
#MOUNT_ROOT=/mnt
#PEER_MOUNT=/mnt/other-printer/printer_data/config

# NFS options rendered by dev/render_nfs_config.sh.
#NFS_MOUNT_OPTS=defaults,nofail,soft,timeo=14,_netdev,x-systemd.automount
#NFS_EXPORT_OPTS=rw,sync,no_subtree_check,fsid=0
